{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "web_app",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/web_simulator/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/web_app/:path*",
      "destination": "/:path*"
    }
  ]
}
