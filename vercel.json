{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/web_simulator/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/web_app/:path*",
      "destination": "/:path*"
    }
  ]
}
