# Copy to .env and fill in real values before deploying. Never commit the real .env file.

PORT=4000
NODE_ENV=development

# JWT signing secret for session tokens (45-day expiry). Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# SESSION_TTL_DAYS controls how long a logged-in session stays valid without re-entering OTP.
SESSION_TTL_DAYS=45

# --- SMS / OTP provider (REQUIRED for real OTP delivery) ---
# This backend ships with a MOCK provider (services/smsProvider.ts) that logs the OTP to the
# server console instead of sending an SMS, so the app is demoable without a live account.
# Wire in a real provider (MSG91, Gupshup, Twilio, AWS SNS/Pinpoint, Karix, etc.) before
# any real farmer registers with their real phone number.
SMS_PROVIDER=mock
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=

# --- Optional: AI vision-assisted diagnosis via the Anthropic API ---
# If set, the backend will send an uploaded plant-organ photo to Claude for a symptom read,
# then cross-reference the result against knowledge-base.json for local remedies. If unset,
# the diagnosis endpoint falls back to the manual symptom-checklist flow only.
ANTHROPIC_API_KEY=

# SQLite database file path (WAL mode)
DB_PATH=./data/krishi.db
